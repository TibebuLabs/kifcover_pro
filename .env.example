# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:kifcover123@localhost:5432/kifcoverdb"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-random-256-bit-secret-in-production"
