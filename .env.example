PRODUCTS_SVC_PORT=3003
QUOTES_SVC_PORT=3004
POLICIES_SVC_PORT=3005
CLAIMS_SVC_PORT=3006
PAYMENTS_SVC_PORT=3007
KYC_SVC_PORT=3008
PARTNERS_SVC_PORT=3009
ANALYTICS_SVC_PORT=3010

# ─── Service Host (localhost for dev, service name for Docker) ─────────────────
SERVICE_HOST=localhost

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
