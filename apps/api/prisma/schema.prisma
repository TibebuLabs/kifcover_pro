generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  PARTNER_ADMIN
  PLATFORM_ADMIN
  INSURANCE_PROVIDER
}

enum KycStatus {
  PENDING
  IN_PROGRESS
  VERIFIED
  REJECTED
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAID
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ProductCategory {
  AUTO
  HEALTH
  TRAVEL
  GADGET
  LIFE
  AGRICULTURE
}

// ─── Core Models ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?   @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole  @default(CUSTOMER)
  kycStatus     KycStatus @default(PENDING)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  kycDocuments  KycDocument[]
  policies      Policy[]
  claims        Claim[]
  partner       Partner?      @relation(fields: [partnerId], references: [id])
  partnerId     String?

  @@map("users")
}

model Partner {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  apiKey        String   @unique @default(uuid())
  webhookUrl    String?
  logoUrl       String?
  isActive      Boolean  @default(true)
  commissionRate Float   @default(0.15)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  users         User[]
  policies      Policy[]
  payouts       Payout[]

  @@map("partners")
}

model InsuranceProduct {
  id            String          @id @default(uuid())
  name          String
  description   String
  category      ProductCategory
  basePrice     Float
  coverageAmount Float
  durationDays  Int
  features      Json            @default("[]")
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  policies      Policy[]
  quotes        Quote[]

  @@map("insurance_products")
}

model Quote {
  id          String   @id @default(uuid())
  userId      String?
  productId   String
  premium     Float
  coverageAmount Float
  metadata    Json     @default("{}")
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  // Relations
  product     InsuranceProduct @relation(fields: [productId], references: [id])
  policy      Policy?

  @@map("quotes")
}

model Policy {
  id            String       @id @default(uuid())
  policyNumber  String       @unique @default(uuid())
  userId        String
  productId     String
  partnerId     String?
  quoteId       String?      @unique
  status        PolicyStatus @default(PENDING)
  premium       Float
  coverageAmount Float
  startDate     DateTime
  endDate       DateTime
  pdfUrl        String?
  qrCode        String?
  metadata      Json         @default("{}")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  user          User             @relation(fields: [userId], references: [id])
  product       InsuranceProduct @relation(fields: [productId], references: [id])
  partner       Partner?         @relation(fields: [partnerId], references: [id])
  quote         Quote?           @relation(fields: [quoteId], references: [id])
  payments      Payment[]
  claims        Claim[]

  @@index([userId])
  @@index([partnerId])
  @@index([status])
  @@index([createdAt])
  @@map("policies")
}

model Claim {
  id            String      @id @default(uuid())
  claimNumber   String      @unique @default(uuid())
  userId        String
  policyId      String
  status        ClaimStatus @default(SUBMITTED)
  description   String
  incidentDate  DateTime
  claimAmount   Float
  approvedAmount Float?
  documents     Json        @default("[]")
  adminNotes    String?
  resolvedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  user          User    @relation(fields: [userId], references: [id])
  policy        Policy  @relation(fields: [policyId], references: [id])
  payments      Payment[]

  @@index([userId])
  @@index([policyId])
  @@index([status])
  @@index([createdAt])
  @@map("claims")
}

model Payment {
  id            String        @id @default(uuid())
  policyId      String?
  claimId       String?
  amount        Float
  currency      String        @default("ETB")
  status        PaymentStatus @default(PENDING)
  provider      String        // telebirr, bank, card
  providerRef   String?
  metadata      Json          @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  policy        Policy?  @relation(fields: [policyId], references: [id])
  claim         Claim?   @relation(fields: [claimId], references: [id])

  @@index([policyId])
  @@index([status])
  @@map("payments")
}

model KycDocument {
  id          String   @id @default(uuid())
  userId      String
  type        String   // national_id, selfie, address_proof
  fileUrl     String
  status      String   @default("pending") // pending, verified, rejected
  ocrData     Json?
  createdAt   DateTime @default(now())

  // Relations
  user        User @relation(fields: [userId], references: [id])

  @@map("kyc_documents")
}

model Payout {
  id          String   @id @default(uuid())
  partnerId   String
  amount      Float
  currency    String   @default("ETB")
  status      String   @default("pending")
  period      String   // e.g. "2024-01"
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  // Relations
  partner     Partner @relation(fields: [partnerId], references: [id])

  @@map("payouts")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  resource    String
  resourceId  String?
  ipAddress   String?
  userAgent   String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}
