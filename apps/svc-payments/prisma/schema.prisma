generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/svc-payments-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Payment {
  id          String        @id @default(uuid())
  policyId    String?       // logical ref to svc-policies
  claimId     String?       // logical ref to svc-claims
  userId      String        // logical ref to svc-users
  amount      Float
  currency    String        @default("ETB")
  status      PaymentStatus @default(PENDING)
  provider    PaymentProvider
  providerRef String?
  checkoutUrl String?
  metadata    Json          @default("{}")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([policyId])
  @@index([claimId])
  @@index([userId])
  @@index([status])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  TELEBIRR
  BANK
  CARD
}
