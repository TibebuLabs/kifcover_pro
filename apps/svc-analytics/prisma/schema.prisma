generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/svc-analytics-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Analytics service stores pre-aggregated snapshots and audit logs
// Real-time KPIs are computed by querying other services via TCP

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  service    String   // which microservice originated the event
  action     String
  resource   String
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([service])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model DailySnapshot {
  id                   String   @id @default(uuid())
  date                 DateTime @unique
  totalUsers           Int      @default(0)
  newUsers             Int      @default(0)
  totalPolicies        Int      @default(0)
  newPolicies          Int      @default(0)
  activePolicies       Int      @default(0)
  totalClaims          Int      @default(0)
  newClaims            Int      @default(0)
  grossWrittenPremium  Float    @default(0)
  totalPaymentsAmount  Float    @default(0)
  createdAt            DateTime @default(now())

  @@index([date])
  @@map("daily_snapshots")
}
