generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/svc-users-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users service owns profile data and KYC status.
// Credentials live in svc-auth. Same UUID is shared across both DBs.
model User {
  id        String    @id @default(uuid())
  email     String    @unique
  phone     String?
  firstName String
  lastName  String
  role      UserRole  @default(CUSTOMER)
  kycStatus KycStatus @default(PENDING)
  isActive  Boolean   @default(true)
  partnerId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
  @@index([partnerId])
  @@map("users")
}

enum UserRole {
  CUSTOMER
  PARTNER_ADMIN
  PLATFORM_ADMIN
  INSURANCE_PROVIDER
}

enum KycStatus {
  PENDING
  IN_PROGRESS
  VERIFIED
  REJECTED
}
