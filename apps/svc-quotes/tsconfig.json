{
    "compilerOptions":  {
                            "module":  "commonjs",
                            "declaration":  true,
                            "removeComments":  true,
                            "emitDecoratorMetadata":  true,
                            "experimentalDecorators":  true,
                            "allowSyntheticDefaultImports":  true,
                            "target":  "ES2020",
                            "sourceMap":  true,
                            "outDir":  "./dist",
                            "baseUrl":  "./",
                            "incremental":  true,
                            "skipLibCheck":  true,
                            "strictNullChecks":  false,
                            "typeRoots":  [
                                              "./node_modules/@types",
                                              "../../node_modules/@types"
                                          ],
                            "paths":  {
                                          "@nestjs/*":  [
                                                            "../../node_modules/@nestjs/*"
                                                        ],
                                          "rxjs":  [
                                                       "../../node_modules/rxjs"
                                                   ],
                                          "rxjs/*":  [
                                                         "../../node_modules/rxjs/*"
                                                     ]
                                      }
                        }
}
