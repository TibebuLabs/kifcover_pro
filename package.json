{
  "name": "kifcover_pro",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"GW,AUTH,USERS,PROD,QUOTE,POLICY,CLAIMS,PAY,KYC,PART,ANLYT,WEB\" -c \"cyan,blue,magenta,yellow,green,red,white,bgBlue,bgGreen,bgYellow,bgMagenta,bgCyan\" \"yarn dev:gateway\" \"yarn dev:auth\" \"yarn dev:users\" \"yarn dev:products\" \"yarn dev:quotes\" \"yarn dev:policies\" \"yarn dev:claims\" \"yarn dev:payments\" \"yarn dev:kyc\" \"yarn dev:partners\" \"yarn dev:analytics\" \"yarn dev:web\"",
    "dev:gateway": "yarn workspace @kifcover/gateway start:dev",
    "dev:auth": "yarn workspace @kifcover/svc-auth start:dev",
    "dev:users": "yarn workspace @kifcover/svc-users start:dev",
    "dev:products": "yarn workspace @kifcover/svc-products start:dev",
    "dev:quotes": "yarn workspace @kifcover/svc-quotes start:dev",
    "dev:policies": "yarn workspace @kifcover/svc-policies start:dev",
    "dev:claims": "yarn workspace @kifcover/svc-claims start:dev",
    "dev:payments": "yarn workspace @kifcover/svc-payments start:dev",
    "dev:kyc": "yarn workspace @kifcover/svc-kyc start:dev",
    "dev:partners": "yarn workspace @kifcover/svc-partners start:dev",
    "dev:analytics": "yarn workspace @kifcover/svc-analytics start:dev",
    "dev:web": "yarn workspace @kifcover/web dev",
    "build": "yarn build:services && yarn build:web",
    "build:services": "concurrently \"yarn build:gateway\" \"yarn build:auth\" \"yarn build:users\" \"yarn build:products\" \"yarn build:quotes\" \"yarn build:policies\" \"yarn build:claims\" \"yarn build:payments\" \"yarn build:kyc\" \"yarn build:partners\" \"yarn build:analytics\"",
    "build:gateway": "yarn workspace @kifcover/gateway build",
    "build:auth": "yarn workspace @kifcover/svc-auth build",
    "build:users": "yarn workspace @kifcover/svc-users build",
    "build:products": "yarn workspace @kifcover/svc-products build",
    "build:quotes": "yarn workspace @kifcover/svc-quotes build",
    "build:policies": "yarn workspace @kifcover/svc-policies build",
    "build:claims": "yarn workspace @kifcover/svc-claims build",
    "build:payments": "yarn workspace @kifcover/svc-payments build",
    "build:kyc": "yarn workspace @kifcover/svc-kyc build",
    "build:partners": "yarn workspace @kifcover/svc-partners build",
    "build:analytics": "yarn workspace @kifcover/svc-analytics build",
    "build:web": "yarn workspace @kifcover/web build",
    "db:generate": "yarn workspace @kifcover/prisma generate",
    "db:migrate": "yarn workspace @kifcover/prisma migrate:dev",
    "db:migrate:deploy": "yarn workspace @kifcover/prisma migrate:deploy",
    "db:seed": "yarn workspace @kifcover/prisma seed",
    "db:studio": "yarn workspace @kifcover/prisma studio",
    "docker:up": "docker compose -f infrastructure/docker-compose.yml up --build",
    "docker:down": "docker compose -f infrastructure/docker-compose.yml down",
    "docker:logs": "docker compose -f infrastructure/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@nestjs/core": "11.1.27",
    "@nestjs/microservices": "^11.1.27"
  }
}
